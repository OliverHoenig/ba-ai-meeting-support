{
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.formatting.tex-fmt.path": "/opt/homebrew/bin/tex-fmt",
  "latex-workshop.formatting.tex-fmt.args": [
    "--wraplen",
    "120",
    "--tabsize",
    "2"
  ],
  "latex-workshop.latex.root": "main.tex",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.build.forceRecipeUsage": true,
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.recipe.default": "latexmk (lualatex)",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=build",
        "%DOCFILE%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (lualatex)",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.rulers": [
      120
    ],
    "editor.formatOnSave": true,
    "editor.wordWrap": "off"
  }
}