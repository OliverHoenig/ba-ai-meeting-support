        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-67" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;SYSTEM_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;This is a conversation between {num_participants} speakers. The speakers are: {participant_list}. Predict who the next speaker will be based on the last 5 utterances. Return ONLY the speaker name. If the next speaker is not clearly allocated to a specific speaker and any speaker could take the floor in the next turn, return \&quot;anyone\&quot;.&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;USER_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;&amp;lt;Task&amp;gt;Last 5 utterances:\n{last_5_utterances}\nPrediction:&amp;nbsp;&lt;/div&gt;" vertex="1">
