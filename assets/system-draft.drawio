          <mxGeometry height="65" width="320" x="-1160" y="1267.5" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-101" edge="1" parent="1" source="s_qPIoGJHtFuNRTP7Hjg-102" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" target="s_qPIoGJHtFuNRTP7Hjg-103">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-102" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;events E, Thought reservoir T ,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;IF ∃t ∈ T such that score (t) ≥ interruptThreshold&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;THEN Select the highest-rated thought:&amp;nbsp; &lt;b&gt;&lt;i&gt;t∗&lt;/i&gt;&lt;/b&gt; = arg &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;maxt ∈T score (t);&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ELSE IF t ∈ T such that&amp;nbsp; score (t) ≥ interruptThreshold &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;THEN The AI remains silent;&amp;nbsp;&lt;b&gt;&lt;i&gt;t∗&lt;/i&gt;&lt;/b&gt; = null&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="320" x="-1160" y="1402.5" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-103" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;IF &lt;b&gt;&lt;i&gt;t∗&lt;/i&gt;&lt;/b&gt; is not null&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;THEN Participate with &lt;b&gt;&lt;i&gt;t∗;&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;ELSE Take no action;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="200" x="-760" y="1402.5" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Process According to Turn-Taking Type" vertex="1">
          <mxGeometry height="40" width="220" x="-1160" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-105" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Finalize Participation" vertex="1">
          <mxGeometry height="40" width="220" x="-760" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-106" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Procedural Stimulus Injection: Facilitation Policy Layer" vertex="1">
          <mxGeometry height="40" width="180" x="-1760" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-108" edge="1" parent="1" source="s_qPIoGJHtFuNRTP7Hjg-107" style="shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0;exitDx=260;exitDy=97.5;exitPerimeter=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=none;endFill=0;" target="s_qPIoGJHtFuNRTP7Hjg-96">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-107" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Addapt this prompt:&lt;/div&gt;&lt;div&gt;Es ist entweder any_participant dran anyone oder der ai_facilitaotr. Der AI_Facilitaor ist nur sicher darn wenn er explizit angesprochen wurde.&lt;/div&gt;&lt;div&gt;Negativ Beispiel: &quot;Was meint ihr dazu?&quot; Das könnte von den vorgeschalgen prmpt als open_to_anyone klassifiziert werden, wobei damit explizit nicht die mienung des facilitators gemeint ist, sondern die eines Teilnehmers&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="260" x="-2220" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-109" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Facilitation Policy Tools" vertex="1">
          <mxGeometry height="40" width="180" x="-420" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-110" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Paraphrase" vertex="1">
          <mxGeometry height="40" width="70" x="-440" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-111" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="check_participation_split" vertex="1">
          <mxGeometry height="40" width="160" x="-80" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-112" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="speach_balance" vertex="1">
          <mxGeometry height="40" width="100" x="-2010" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-113" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;IF Teilnehmer X hat seit &amp;gt; 5min nichts gesagt&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;THEN &lt;i&gt;&lt;b&gt;t*(&lt;/b&gt;&lt;/i&gt;&lt;i&gt;injection_on_speaker_x_silence&lt;/i&gt;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="280" x="-1760" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-114" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;IF Teilnehmer X hat seit &amp;gt; 50% Redeanteil&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;THEN &lt;i&gt;&lt;b&gt;t*(&lt;/b&gt;&lt;/i&gt;&lt;i&gt;injection_on_speaker_x_dominance&lt;/i&gt;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="280" x="-1760" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-115" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;IF Stagnation des Gesprächs für &amp;gt; 15 Sekunden&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;THEN &lt;i&gt;&lt;b&gt;t*(&lt;/b&gt;&lt;/i&gt;&lt;i&gt;injection_on_pause&lt;/i&gt;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="280" x="-1760" y="2280" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-116" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;SYSTEM_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;Teilnehmer {teilnehmername} ist seit {on_silence_threashhold} Minuten stumm. Best Practice für Moderation: Fasse den bisherigen Konsen kurz zusammen und fordere X direkt und wertschätzend auf Stellung zu beziehen.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;TODO Beispiele aus Interviews anfügen:&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;USER_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;&amp;lt;Task&amp;gt;Last 5 utterances:\n{last_5_utterances}\nPrediction:&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="260" x="-1400" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-117" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="summarize_on_topic_x" vertex="1">
          <mxGeometry height="40" width="130" x="-280" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-118" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;SYSTEM_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;Teilnehmer {teilnehmername} dominiert die Sprechzeit. Best Practice für Moderation: Bedanke dich höflich für den Input, unterbtich {teilnehmername} sanft und öffe die Diskussion explizit fpr die anderen Gruppenmitgleider.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;TODO Beispiele aus Interviews anfügen:&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;USER_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;&amp;lt;Task&amp;gt;Last 5 utterances:\n{last_5_utterances}\nPrediction:&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="260" x="-1400" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-119" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;SYSTEM_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;Das Gespräch stickt. Wirf eine strukturierende offene Frage ein, um das Thema aus eienr neune Perspektive zu beleuchten&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;TODO Beispiele aus Interviews anfügen:&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;USER_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;&amp;lt;Task&amp;gt;Last 5 utterances:\n{last_5_utterances}\nPrediction:&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="260" x="-1400" y="2280" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-120" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=10;" value="&lt;div&gt;SYSTEM_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;You are playing a role as the professional AI Facilitator in an online multi-party meeting. Your name in the conversation is {agent.name}.&lt;br&gt;Your goal is to guide the group toward an objective decision, ensure all evaluation criteria are balanced, and mitigate cognitive biases (such as the Shared Information Bias).&lt;br&gt;You will generate covert thoughts in JSON format representing your internal facilitation instincts.&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;USER_PROMPT:&lt;/div&gt;&lt;div&gt;Your goal is to guide the conversation process efficiently, inclusively, and neutrally.&amp;nbsp;&lt;br&gt;You will be simulating the process of forming a covert thought in parallel with the conversation. Specifically, you are using an adapted System 1 thinking for facilitators.&lt;/div&gt;&lt;br&gt;System 1 thinking for a facilitator is characterized by quick, automatic, and process-oriented reactions rather than deep content analysis or heavy memory recall.&amp;nbsp;&lt;br&gt;For a professional facilitator, these intuitive reactions include:&lt;br&gt;- Active Listening / Acknowledgment (e.g., &quot;I should acknowledge Alice&#39;s valuable input&quot;)&lt;br&gt;- Maintaining Flow / Pace Control (e.g., &quot;I should keep the momentum going&quot;)&lt;br&gt;- Soft Inclusivity (e.g., &quot;I should check if someone wants to add to this&quot;)&lt;br&gt;- Yielding / Self-Restraint (e.g., &quot;I should stay silent and let them continue their productive exchange&quot;)&lt;br&gt;&lt;br&gt;Note: Facilitator System 1 thoughts are strictly process-focused. They are NOT personal opinions, emotional reactions, or personal anecdotes." vertex="1">
          <mxGeometry height="400" width="480" x="-800" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-121" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=10;spacingRight=10;spacingBottom=10;spacingTop=10;" value="&lt;div&gt;SYSTEM_PROMPT:&lt;/div&gt;&lt;div&gt;&quot;You are playing a role as the professional AI Facilitator in an online multi-party meeting. Your name in the conversation is {agent.name}.&lt;br&gt;You will generate covert thoughts in JSON format. Generate thoughts that authentically reflect your facilitation objectives, process-steering knowledge, and active group observation.&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;USER_PROMPT:&lt;/div&gt;&lt;div&gt;Your goal is to guide the multi-party group toward an objective and balanced decision, ensure all key evaluation criteria are thoroughly discussed, and actively mitigate cognitive biases (such as the Shared Information Bias).&lt;br&gt;You will be simulating the process of forming covert thoughts in parallel with the conversation. Specifically, use System 2 thinking (slow, deliberate, and context-driven reasoning).&lt;br&gt;You are provided contexts including the conversation history, salient memories, previous thoughts, and active facilitation policies.&lt;br&gt;You should leverage or be inspired by the one or more than one contexts provided that are most likely to come up at this point.&lt;br&gt;&lt;br&gt;&amp;lt;Thought Generation Guidelines&amp;gt;&lt;br&gt;1. Form {num_thoughts} thought(s) that you would most likely have at this point in the conversation, given your objectives and the current meeting state.&lt;br&gt;2. Your thoughts should:&lt;br&gt;&amp;nbsp; &amp;nbsp;- Be STRONGLY influenced by your facilitation objectives, previous thoughts, and active facilitation policies&lt;br&gt;&amp;nbsp; &amp;nbsp;- Reflect your professional facilitation perspective and process-steering knowledge&lt;br&gt;&amp;nbsp; &amp;nbsp;- Express genuine procedural relevance to the ongoing meeting dynamics (e.g., managing speaker balance, bringing in silent members, or highlighting unaddressed criteria)&lt;br&gt;&amp;nbsp; &amp;nbsp;- Vary in motivation level (some thoughts are silent process you might keep to yourself, while others represent highly urgent interventions you feel motivated to express)&lt;br&gt;3. Each thought should be as succinct as possible, and be less than 15 words.&lt;br&gt;4. Ensure these thoughts are diverse and distinct, make sure each thought is unique and not a repetition of another thought in the same batch.&lt;br&gt;5. Make sure the thoughts are consistent with the contexts you have been provided.&lt;br&gt;&lt;br&gt;IMPORTANT: If the conversation is proceeding perfectly and balanced, generate thoughts that reflect monitoring and self-restraint (e.g., letting the human flow continue). Do not force interventions where none are needed.&lt;br&gt;&lt;br&gt;For each thought, provide the stimuli from the contexts provided. Stimuli can be:&lt;br&gt;- Conversation History: CON#id&lt;br&gt;- Salient Memories: MEM#id&lt;br&gt;- Previous Thoughts: THO#id&lt;br&gt;- Active Facilitation Policy (PSIL): PSI#id&lt;br&gt;where #id is the id, for example, MEM#3, THO#2, CON#14, PSI#0.&lt;br&gt;You can have MORE THAN ONE stimulus for each thought.&lt;br&gt;&lt;br&gt;&amp;lt;Context&amp;gt;&lt;br&gt;Overall Context: {overall_context}&lt;br&gt;Conversation History: {conversation_history}&lt;br&gt;Salient Memories: {memories_text}&lt;br&gt;Previous Thoughts: {thoughts_text}&lt;br&gt;&lt;br&gt;Procedural Stimulus Injection (PSIL):&lt;br&gt;- PSI#0: [Trigger: {active_psil_trigger}] {active_psil_policy}&lt;br&gt;&lt;br&gt;Respond with a JSON object in the following format:&lt;br&gt;{{&lt;br&gt;&amp;nbsp; &quot;thoughts&quot;: [&lt;br&gt;&amp;nbsp; &amp;nbsp; {{&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;content&quot;: &quot;The thought content here&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;stimuli&quot;: [&quot;CON#0&quot;, &quot;PSI#0&quot;, &quot;THO#2&quot;]&lt;br&gt;&amp;nbsp; &amp;nbsp; }}&lt;br&gt;&amp;nbsp; ]&lt;br&gt;}}&lt;/div&gt;" vertex="1">
          <mxGeometry height="840" width="680" x="-800" y="2240" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-122" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="send_private_message" vertex="1">
          <mxGeometry height="40" width="160" x="-80" y="1402.5" as="geometry" />
        </mxCell>
        <mxCell id="s_qPIoGJHtFuNRTP7Hjg-123" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="interact_pubilc" vertex="1">
          <mxGeometry height="40" width="160" x="-80" y="1477.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
