  author      = {Jiang, Hang and Zhu, Yuanxin and Yang, Diyi and Kim, Yoon and Roy, Deb and Kabbara, Jad},
  date        = {2026-07-12},
  eprint      = {2607.10850},
  eprinttype  = {arXiv},
